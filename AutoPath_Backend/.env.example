# AutoPath Backend Environment Configuration
# Copy this file to .env and adjust credentials as appropriate

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Origins (Comma-separated for CORS)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Connection Settings
# You can provide a full DATABASE_URL or individual PG* variables
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autopath
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=autopath
DB_SSL=false
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000

# Authentication (JWT Secret)
JWT_SECRET=autopath_super_secret_jwt_key_2026_kolkata_routes
JWT_EXPIRES_IN=24h

# Admin Bootstrap Credentials (Used during initial seeding)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_EMAIL=admin@autopath.kolkata.in
ADMIN_DEFAULT_PASSWORD=Admin@AutoPath2026

