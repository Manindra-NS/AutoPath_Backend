{
  "info": {
    "name": "AutoPath Backend API",
    "_postman_id": "autopath-api-v1",
    "description": "Complete Postman collection for AutoPath Backend REST APIs (Kolkata Auto-Rickshaw Routes).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Public Transit APIs",
      "item": [
        {
          "name": "1. Get All Stands (/api/stands)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stands",
              "host": ["{{baseUrl}}"],
              "path": ["stands"]
            }
          }
        },
        {
          "name": "2. Get Stand by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stands/ruby-more",
              "host": ["{{baseUrl}}"],
              "path": ["stands", "ruby-more"]
            }
          }
        },
        {
          "name": "3. Get Routes by Stand ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stands/ruby-more/routes",
              "host": ["{{baseUrl}}"],
              "path": ["stands", "ruby-more", "routes"]
            }
          }
        },
        {
          "name": "4. Search Routes (From / To)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/routes/search?from=Ruby More&to=Gariahat",
              "host": ["{{baseUrl}}"],
              "path": ["routes", "search"],
              "query": [
                { "key": "from", "value": "Ruby More" },
                { "key": "to", "value": "Gariahat" }
              ]
            }
          }
        },
        {
          "name": "5. Get Route Details by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/routes/ruby-gariahat",
              "host": ["{{baseUrl}}"],
              "path": ["routes", "ruby-gariahat"]
            }
          }
        },
        {
          "name": "6. Get Route Geometry (Prompt Section 9 Contract)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/routes/ruby-gariahat/geometry",
              "host": ["{{baseUrl}}"],
              "path": ["routes", "ruby-gariahat", "geometry"]
            }
          }
        },
        {
          "name": "7. Get Route Intermediate Stops",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/routes/ruby-gariahat/stops",
              "host": ["{{baseUrl}}"],
              "path": ["routes", "ruby-gariahat", "stops"]
            }
          }
        },
        {
          "name": "8. Autocomplete Location Search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/locations/search?q=Garia",
              "host": ["{{baseUrl}}"],
              "path": ["locations", "search"],
              "query": [
                { "key": "q", "value": "Garia" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Administrative APIs",
      "item": [
        {
          "name": "1. Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "    pm.collectionVariables.set('adminToken', res.data.token);",
                  "    console.log('Admin token saved to collection variables.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@AutoPath2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "auth", "login"]
            }
          }
        },
        {
          "name": "2. Create New Route (Transactional)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"ruby-chowbaga-postman\",\n  \"route_name\": \"Ruby More ⇄ Chowbaga / Anandapur\",\n  \"source_stop_id\": \"ruby-more\",\n  \"destination_stop_id\": \"chowbaga\",\n  \"fare_fixed\": \"₹14.00 Fixed\",\n  \"distance\": \"~3.1 km\",\n  \"est_travel_min\": 12,\n  \"intermediate_points\": [\n    { \"sequence_number\": 1, \"latitude\": 22.5134, \"longitude\": 88.3995 },\n    { \"sequence_number\": 2, \"latitude\": 22.5145, \"longitude\": 88.4080 },\n    { \"sequence_number\": 3, \"latitude\": 22.5160, \"longitude\": 88.4140 },\n    { \"sequence_number\": 4, \"latitude\": 22.5180, \"longitude\": 88.4230 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/routes",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "routes"]
            }
          }
        },
        {
          "name": "3. Add Intermediate Coordinates",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"points\": [\n    { \"sequence_number\": 5, \"latitude\": 22.5190, \"longitude\": 88.4250 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/routes/ruby-chowbaga-postman/points",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "routes", "ruby-chowbaga-postman", "points"]
            }
          }
        },
        {
          "name": "4. Update / Reorder Intermediate Coordinates",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"points\": [\n    { \"sequence_number\": 1, \"latitude\": 22.5134, \"longitude\": 88.3995 },\n    { \"sequence_number\": 2, \"latitude\": 22.5150, \"longitude\": 88.4110 },\n    { \"sequence_number\": 3, \"latitude\": 22.5180, \"longitude\": 88.4230 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/routes/ruby-chowbaga-postman/points",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "routes", "ruby-chowbaga-postman", "points"]
            }
          }
        },
        {
          "name": "5. Deactivate Route",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/routes/ruby-chowbaga-postman",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "routes", "ruby-chowbaga-postman"]
            }
          }
        },
        {
          "name": "6. Reactivate Route",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/routes/ruby-chowbaga-postman/activate",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "routes", "ruby-chowbaga-postman", "activate"]
            }
          }
        }
      ]
    }
  ]
}

